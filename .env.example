# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=test_kafka_aws

# FinancialModelingPrep API
API_BASE_URL=https://financialmodelingprep.com/api/v3/stock_market/actives
API_KEY=your_api_key_here

# AWS / S3
S3_BUCKET=stock-pipeline-data
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Spark
SPARK_APP_NAME=StockPipeline

# Producer
PRODUCER_INTERVAL_SECONDS=360
PRODUCER_MAX_ITERATIONS=0
